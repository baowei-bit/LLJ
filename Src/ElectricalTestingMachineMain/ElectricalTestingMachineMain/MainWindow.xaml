<Window x:Class="ElectricalTestingMachineMain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectricalTestingMachineMain"
        mc:Ignorable="d"
        xmlns:main="clr-namespace:ElectricalTestingMachineMain.View.MainLayout"
        AllowsTransparency="True" Height="650" Width="1080" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <main:TitleView Grid.Row="0"/>

        <main:MainContentView Grid.Row="1"/>
        <main:BottomView Grid.Row="2"/>
    </Grid>
</Window>
