<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      >

	<extensions>
		<add assembly="ElectricalTestingMachineMain"/>
	</extensions>

	<targets>
		<target xsi:type="File" name="fileTarget"
		   fileName="${var:logDirectory:whenEmpty=${basedir}/Logs}/${shortdate}.log"
		   layout="${longdate} |${level:uppercase=true:padding=-5} | ${logger} |${message} ${exception:format=ToString}"
		   keepFileOpen="true"
		   concurrentWrites="true"
			maxArchiveFiles="30"
				archiveAboveSize="104857600"
			archiveEvery="Day"
	   encoding="utf-8" />
		<target xsi:type="RichTextBoxTarget" name="richTextBoxTarget"
				layout="${longdate} |${level:uppercase=true:padding=-5} | ${message}${exception:format=ToString}" />
		<target xsi:type="File" name="developerFileTarget"
		   fileName="${var:logDirectory:whenEmpty=${basedir}/Logs}/${shortdate} Developer.log"
		   layout="${longdate} |${level:uppercase=true:padding=-5} | ${logger} |${message} ${exception:format=ToString}"
		   keepFileOpen="true"
		   concurrentWrites="true"
			maxArchiveFiles="30"
				archiveAboveSize="104857600"
			archiveEvery="Day"
	   encoding="utf-8" />
	</targets>

	<rules>
		<logger name="*" minlevel="Info" writeTo="richTextBoxTarget" />
		<logger name="*" minlevel="Info" writeTo="fileTarget" />
		<logger name="*" minlevel="Debug" writeTo="developerFileTarget" />
	</rules>
</nlog>
