<Window x:Class="ElectricalTestingMachineMain.View.Login.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectricalTestingMachineMain.View.Login"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:ElectricalTestingMachineMain.ViewModel.Login"
         Title="用户登录" Height="300" Width="400"
 WindowStartupLocation="CenterScreen"
 WindowStyle="None"
 AllowsTransparency="True"
 Background="Transparent"
 ResizeMode="NoResize">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>
    <Border CornerRadius="10" Background="White" BorderBrush="#1772f6" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="拉力测试系统" FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center" Foreground="#1772f6"/>

            <!-- 角色选择 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="角色：" VerticalAlignment="Center" FontSize="15" Margin="0 0 10 0"/>
                <ComboBox x:Name="RoleComboBox" Width="200" Height="32" FontSize="14" SelectedIndex="0" SelectionChanged="RoleComboBox_SelectionChanged">
                    <ComboBoxItem Content="作业员"/>
                    <ComboBoxItem Content="工程师"/>
                </ComboBox>
            </StackPanel>

            <!-- 密码输入 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                      x:Name="PasswordPanel" Visibility="Collapsed">
                <TextBlock Text="密  码：" VerticalAlignment="Center" FontSize="14" Width="60"/>
                <PasswordBox x:Name="PasswordBox" Width="200" Height="32" FontSize="14"/>
            </StackPanel>

            <!-- 错误信息 -->
            <TextBlock Grid.Row="6" x:Name="ErrorText" Text="" Foreground="Red" FontSize="12"
                     HorizontalAlignment="Center" Visibility="Collapsed"/>

            <!-- 登录按钮 -->
            <Button Grid.Row="8" Content="登  录" Width="150" Height="38" FontSize="16"
                  Click="LoginButton_Click"
                  HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
