<UserControl x:Class="ElectricalTestingMachineMain.View.MainLayout.TitleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ElectricalTestingMachineMain.View.MainLayout"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:ElectricalTestingMachineMain.ViewModel.MainLayout"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:TitleViewModel/>
    </UserControl.DataContext>
    <Border Height="40" CornerRadius="15 15 0 0" Background="#1772f6" BorderThickness="0.1">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10 5 10 5" VerticalAlignment="Center">
                <!--图标，-->
                <Image Visibility="Collapsed"/>
                <TextBlock Text="拉力测试软件" Foreground="White" Height="15" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="ScanButton" Margin="0,0,8,0" Padding="12,3" Foreground="White"
                        Background="#2563EB" Click="ScanButton_Click" ToolTip="点击选择扫码模式">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="自动扫码（键盘模拟）" Tag="Automatic" Click="ScanMode_Click"/>
                            <MenuItem Header="手动扫码（USB HID POS）" Tag="Manual" Click="ScanMode_Click"/>
                            <MenuItem Header="不扫码" Tag="Disabled" Click="ScanMode_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="MesBadge" Padding="12,3" Foreground="White" Background="#DC2626"
                        Click="MesButton_Click" ToolTip="点击启用或关闭 MES，颜色表示端口连接状态">
                    <TextBlock x:Name="MesState" Text="MES 未连接" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
            <UniformGrid Grid.Column="2" Margin="10 5 10 5" VerticalAlignment="Center" Columns="3" Width="100">
                <UniformGrid.Resources>
                    <Style TargetType="Button" >
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Height" Value="15"/>
                        <Setter Property="Width" Value="15"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid >
                                        <Ellipse 
                                      x:Name="Circle"
                                      Stroke="#00000030"
                                      Height="{TemplateBinding Height}" 
                                      Width="{TemplateBinding Width}" 
                                      Fill="{TemplateBinding Background}" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Icon" 
                                             Text="{TemplateBinding Tag}" 
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             FontWeight="Bold" FontSize="15" Foreground="White"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Visibility" TargetName="Icon" Value="Visible"/>
                                            <Setter Property="Stroke" TargetName="Circle" Value="#00000060"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <Button Background="#28C840" Tag="+" x:Name="BtnMaximize" Command="{Binding MaxCommand}"/>
                <Button Background="#FEBC2E" Tag="-" Command="{Binding MiniCommand}"/>
                <Button Background="Red" Tag="✕" Command="{Binding CloseCommand}"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
