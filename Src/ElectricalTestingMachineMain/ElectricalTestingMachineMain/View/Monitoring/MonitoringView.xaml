<UserControl x:Class="ElectricalTestingMachineMain.View.Monitoring.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectricalTestingMachineMain.ViewModel.Monitoring"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext><vm:MonitoringViewModel/></UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#BAE6FD"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/></Style>
        <Style x:Key="ScanInfoPanel" TargetType="Border"><Setter Property="Background" Value="#FEE2E2"/><Setter Property="BorderBrush" Value="#FCA5A5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10,7"/><Style.Triggers><DataTrigger Binding="{Binding HasScannedSerialNumber}" Value="True"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="BorderBrush" Value="#86EFAC"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E0F2FE"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Height" Value="30"/></Style>
    </UserControl.Resources>
    <Grid Background="#F0F9FF">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="模拟测试" Command="{Binding SimulateTestCommand}" Height="32" Padding="12,2" Margin="8,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="请在对应工站的输入框扫码；清空仅影响本工站。扫码成功写 D1008 / D1009 / D1010=1，配方由 PLC 设置。" Foreground="#475569" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ScanStatus}" Foreground="{Binding ScanStatusColor}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <ItemsControl ItemsSource="{Binding Stations}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="{Binding StationName}" FontSize="19" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <Border DockPanel.Dock="Right" Background="{Binding StatusColor}" CornerRadius="10" Padding="9,3"><TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold"/></Border>
                                </DockPanel>
                                <Border Grid.Row="1" Style="{StaticResource ScanInfoPanel}" Margin="0,10,0,7">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="配方" Foreground="#475569" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedRecipe}" Foreground="#0F172A" FontWeight="Bold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="工位 SN" Foreground="#475569" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SerialNumber}" Foreground="#0F172A" FontWeight="Bold" Margin="10,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <StackPanel Margin="0,10,0,0" IsEnabled="{Binding IsEnabled}" Visibility="{Binding DataContext.IsScanEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="6,3" VerticalContentAlignment="Center" TextChanged="StationScanInput_TextChanged" GotKeyboardFocus="StationScanInput_GotKeyboardFocus" KeyDown="StationScanInput_KeyDown" ToolTip="先点击本工站输入框，再扫码。达到配置长度后自动绑定，也可回车提交；HID POS 收到完整条码后直接绑定。"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="清空扫码" Command="{Binding DataContext.ClearStationScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="10,3" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{Binding ConnectionText}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="3" ItemsSource="{Binding TestItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="32" MinHeight="150" BorderBrush="#BAE6FD" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="测试项" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="测试值" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="配方" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Formula}" Margin="8,0,8,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="今日" Foreground="#64748B"/><TextBlock Grid.Column="3" Text="{Binding TodayCount}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                </Grid>
                                <TextBlock Grid.Row="4" Text="{Binding LastCompleted, StringFormat=最近完成：{0}}" Foreground="#64748B" FontSize="11" Margin="0,34,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="14,0,14,14">
            <DockPanel><TextBlock DockPanel.Dock="Top" Text="运行日志" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,8"/><RichTextBox x:Name="LogRichTextBox" IsReadOnly="True" BorderBrush="#E2E8F0" BorderThickness="1" VerticalScrollBarVisibility="Auto"/></DockPanel>
        </Border>
    </Grid>
</UserControl>
